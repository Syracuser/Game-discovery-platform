# Virtual environment
.venv/

# Python cache files (auto-generated when Python runs your code)
__pycache__/

# Environment variables (will contain sensitive info like API keys later)
.env

# Node dependencies (auto-generated by npm install — like .venv for JavaScript)
node_modules/

# Frontend build output (auto-generated by npm run build)
frontend/dist/

# Log files
*.log

# OS junk files
.DS_Store
Thumbs.db
